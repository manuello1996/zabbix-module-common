<?php declare(strict_types = 0);

namespace Modules\__MODULE_NAMESPACE__\Includes\Common;

/** Shared presentation; labels, values and source-item links belong to the caller. */
class Summary {
	public static function card(string $label, $value, array $options = []): \CDiv {
		$figure = (new \CDiv($value))->addClass('__CSS_PREFIX__-card-value');
		if (isset($options['value_id'])) { $figure->setId($options['value_id']); }
		$content = [$figure];
		if (($options['unit'] ?? '') !== '') {
			$content[] = (new \CSpan($options['unit']))->addClass('__CSS_PREFIX__-card-unit');
		}
		if (isset($options['aside'])) {
			$content[] = (new \CDiv($options['aside']))->addClass('__CSS_PREFIX__-statseg-aside');
		}
		$card = (new \CDiv([
			(new \CDiv($label))->addClass('__CSS_PREFIX__-statseg-label'),
			(new \CDiv($content))->addClass('__CSS_PREFIX__-statseg-figure')
		]))->addClass('__CSS_PREFIX__-statseg')->addClass('__CSS_PREFIX__-card-'.($options['modifier'] ?? 'total'));
		foreach ($options['attributes'] ?? [] as $name => $value) { $card->setAttribute($name, $value); }
		return $card;
	}

	public static function strip(array $cards, array $attributes = []): \CDiv {
		$strip = (new \CDiv($cards))->addClass('__CSS_PREFIX__-statstrip');
		foreach ($attributes as $name => $value) { $strip->setAttribute($name, $value); }
		return $strip;
	}
}
