<?php declare(strict_types = 0);

// Generated from zabbix-module-common. Columns and statistics belong to the module.
namespace Modules\__MODULE_NAMESPACE__\Includes\Common;

class LocationRows {
	public static function header(array $group, string $count, array $columns, int $label_span = 1,
			array $groups = []): \CRow {
		$button = (new \CButton(null, [
			(new \CSpan())->addClass('__CSS_PREFIX__-location-chevron')->setAttribute('aria-hidden', 'true'),
			(new \CSpan($group['label']))->addClass('__CSS_PREFIX__-location-name')
		]))->addClass('__CSS_PREFIX__-location-toggle')
			->setAttribute('data-__LOCATION_DATA_PREFIX__-toggle', $group['key'])
			->setAttribute('aria-expanded', ($group['collapsed'] ?? false) ? 'false' : 'true');
		$label = (new \CDiv([$button, (new \CSpan($count))->addClass('__CSS_PREFIX__-location-count')]))
			->addClass('__CSS_PREFIX__-location-group')
			->setAttribute('style', '--__LOCATION_DEPTH_VAR__: '.(int) $group['depth']);
		$row = (new \CRow(array_merge([(new \CCol($label))->setColSpan($label_span)], $columns)))
			->addClass('__CSS_PREFIX__-location-row')
			->setAttribute('data-__LOCATION_DATA_PREFIX__-key', $group['key']);
		return self::withAncestors($row, $group['ancestors'], $groups);
	}

	public static function withAncestors(\CRow $row, array $ancestors, array $groups = []): \CRow {
		$row->setAttribute('data-__LOCATION_DATA_PREFIX__-ancestors', json_encode($ancestors));
		foreach ($ancestors as $key) {
			if ($groups[$key]['collapsed'] ?? false) {
				$row->setAttribute('hidden', 'hidden');
				break;
			}
		}
		return $row;
	}
}
