/* Generated from zabbix-module-common. Module prefixes isolate installed versions. */
.__CSS_PREFIX__-tabs {
	display: flex;
	gap: 4px;
	margin: 14px 0 16px;
	border-bottom: 1px solid var(--__BORDER__);
}

.__CSS_PREFIX__-tab {
	padding: 9px 12px 11px;
	margin-bottom: -1px;
	border-bottom: 2px solid transparent;
	color: var(--__MUTED__);
	white-space: nowrap;
}

.__CSS_PREFIX__-tab:hover {
	color: var(--__TEXT__);
	text-decoration: none;
}

.__CSS_PREFIX__-tab-active {
	color: var(--__STRONG__);
	border-bottom-color: var(--__STRONG__);
	font-weight: bold;
}

/* The complete NetApp search bar, isolated from legacy module input styles. */
.__CSS_PREFIX__-tab-search {
	--__CSS_PREFIX__-tab-search-bg: #fff;
	--__CSS_PREFIX__-tab-search-border: #e0e4e9;
	--__CSS_PREFIX__-tab-search-muted: #647580;
	display: flex;
	align-items: center;
	gap: 10px 14px;
	flex-wrap: wrap;
	padding: 12px 16px;
	margin: 0 0 14px;
	background: var(--__CSS_PREFIX__-tab-search-bg);
	border: 1px solid var(--__CSS_PREFIX__-tab-search-border);
	border-radius: 8px;
}

.__CSS_PREFIX__-tab-search-input {
	width: 260px;
	max-width: 100%;
}

.__CSS_PREFIX__-tab-search-hint {
	color: var(--__CSS_PREFIX__-tab-search-muted);
	font-size: 11px;
}

html[theme="dark-theme"] .__CSS_PREFIX__-tab-search,
html[theme="hc-dark"] .__CSS_PREFIX__-tab-search {
	--__CSS_PREFIX__-tab-search-bg: #2b2b2b;
	--__CSS_PREFIX__-tab-search-border: #454545;
	--__CSS_PREFIX__-tab-search-muted: #b4b4b4;
}
